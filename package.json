{
  "name": "@polyrank/mcp",
  "version": "0.5.1",
  "mcpName": "io.github.polyrank/polyrank-mcp",
  "description": "MCP server for Polyrank — Polymarket trader skill analytics for AI agents.",
  "type": "module",
  "bin": {
    "polyrank-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "echo 'no lint'",
    "prepublishOnly": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "homepage": "https://docs.polyrank.app/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polyrank/PolyRank-MCP.git"
  },
